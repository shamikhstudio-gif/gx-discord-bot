# Discord Bot Configuration

# The bot token from Discord Developer Portal
DISCORD_TOKEN=your_bot_token_here

# The Discord Server (Guild) ID where the bot is permitted to operate
ALLOWED_GUILD_ID=your_server_id_here

# The invite link of your official server
SERVER_INVITE_LINK=https://discord.gg/nezPrgAsnp

# The exact name of the role to assign to new members
AUTO_ROLE_NAME=MEMBER

# Optional: Exact role ID (leave blank to search by name)
AUTO_ROLE_ID=

# Welcome and Leave Channels
WELCOME_CHANNEL_ID=1538560876339265667
LEAVE_CHANNEL_ID=1538561457912946788
